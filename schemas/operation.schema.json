{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laohu.local/music-v3/operation.schema.json",
  "title": "Laohu Music V3 Operation Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "owner_id", "request_id", "payload"],
  "properties": {
    "schema_version": { "const": 1 },
    "operation": {
      "enum": [
        "create_work",
        "get_work_state",
        "get_next_decision",
        "submit_choice",
        "generate_draft",
        "revise_scope",
        "lock_lyrics",
        "select_sound_direction",
        "generate_sound_package",
        "register_music_fragment",
        "register_audio_run",
        "submit_audio_feedback",
        "accept_sound_package",
        "reopen_lyrics",
        "record_learning"
      ]
    },
    "owner_id": { "type": "string", "minLength": 1 },
    "work_id": { "type": ["string", "null"] },
    "request_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "create_work" } }, "required": ["operation"] },
      "then": {
        "properties": {
          "work_id": { "type": "null" },
          "payload": { "$ref": "#/$defs/createWorkPayload" }
        }
      },
      "else": {
        "required": ["work_id"],
        "properties": { "work_id": { "type": "string", "minLength": 1 } }
      }
    },
    {
      "if": { "properties": { "operation": { "enum": ["get_work_state", "get_next_decision"] } }, "required": ["operation"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/emptyPayload" } } }
    },
    {
      "if": { "properties": { "operation": { "const": "submit_choice" } }, "required": ["operation"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/submitChoicePayload" } } }
    },
    {
      "if": { "properties": { "operation": { "const": "generate_draft" } }, "required": ["operation"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/generateDraftPayload" } } }
    },
    {
      "if": { "properties": { "operation": { "const": "revise_scope" } }, "required": ["operation"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/reviseScopePayload" } } }
    },
    {
      "if": { "properties": { "operation": { "const": "lock_lyrics" } }, "required": ["operation"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/lockLyricsPayload" } } }
    },
    {
      "if": { "properties": { "operation": { "const": "select_sound_direction" } }, "required": ["operation"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/selectSoundPayload" } } }
    },
    {
      "if": { "properties": { "operation": { "const": "generate_sound_package" } }, "required": ["operation"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/generateSoundPayload" } } }
    },
    {
      "if": { "properties": { "operation": { "const": "register_music_fragment" } }, "required": ["operation"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/registerMusicFragmentPayload" } } }
    },
    {
      "if": { "properties": { "operation": { "const": "register_audio_run" } }, "required": ["operation"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/registerAudioRunPayload" } } }
    },
    {
      "if": { "properties": { "operation": { "const": "submit_audio_feedback" } }, "required": ["operation"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/audioFeedbackPayload" } } }
    },
    {
      "if": { "properties": { "operation": { "const": "accept_sound_package" } }, "required": ["operation"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/acceptSoundPackagePayload" } } }
    },
    {
      "if": { "properties": { "operation": { "const": "reopen_lyrics" } }, "required": ["operation"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/reopenLyricsPayload" } } }
    },
    {
      "if": { "properties": { "operation": { "const": "record_learning" } }, "required": ["operation"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/recordLearningPayload" } } }
    }
  ],
  "$defs": {
    "emptyPayload": { "type": "object", "additionalProperties": false },
    "createWorkPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "mode"],
      "properties": {
        "input": { "type": "string", "minLength": 1 },
        "title": { "type": ["string", "null"] },
        "work_type": { "enum": ["vocal_song", "instrumental"], "default": "vocal_song" },
        "mode": { "enum": ["director_co_creation", "quick_draft", "studio_experiment"] }
      }
    },
    "submitChoicePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "action"],
      "properties": {
        "decision_id": { "type": "string", "minLength": 1 },
        "action": { "enum": ["select", "keep_original", "reject_all", "custom"] },
        "selected_option_id": { "type": ["string", "null"] },
        "custom_content": { "type": ["string", "null"] },
        "user_reason": { "type": ["string", "null"] }
      }
    },
    "generateDraftPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["director_co_creation", "quick_draft"] }
      }
    },
    "reviseScopePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "feedback"],
      "properties": {
        "level": { "enum": ["section", "line", "word", "music_fragment", "sound_package"] },
        "section_id": { "type": ["string", "null"] },
        "line_id": { "type": ["string", "null"] },
        "fragment_id": { "type": ["string", "null"] },
        "feedback": { "type": "string", "minLength": 1 }
      }
    },
    "lockLyricsPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "lyrics_sha256"],
      "properties": {
        "confirmed": { "const": true },
        "lyrics_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "selectSoundPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "selected_option_id"],
      "properties": {
        "decision_id": { "type": "string", "minLength": 1 },
        "selected_option_id": { "type": "string", "minLength": 1 },
        "compatible_adjustments": { "type": "array", "items": { "type": "string" } }
      }
    },
    "generateSoundPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": { "type": ["string", "null"] },
        "platform_constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "registerMusicFragmentPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fragment", "target"],
      "properties": {
        "fragment": { "$ref": "music-fragment.schema.json" },
        "target": { "enum": ["refined_music_fragment", "sound_prompt_package", "instrumental_prompt_package"] }
      }
    },
    "registerAudioRunPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio_run"],
      "properties": {
        "audio_run": { "$ref": "audio-run.schema.json" }
      }
    },
    "audioFeedbackPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio_run_ids", "analysis_mode", "observations"],
      "properties": {
        "audio_run_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "analysis_mode": { "enum": ["user_text_only", "tool_assisted_audio", "both"] },
        "overall_feeling": { "type": ["string", "null"] },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "aspect", "description", "judgment"],
            "properties": {
              "source": { "enum": ["user", "audio_tool"] },
              "audio_run_id": { "type": ["string", "null"] },
              "start_seconds": { "type": ["number", "null"], "minimum": 0 },
              "end_seconds": { "type": ["number", "null"], "minimum": 0 },
              "aspect": { "enum": ["melody", "rhythm", "groove", "harmony", "arrangement", "vocal", "diction", "dynamics", "structure", "emotion", "platform_behavior", "other"] },
              "description": { "type": "string", "minLength": 1 },
              "judgment": { "enum": ["keep", "change", "uncertain"] },
              "desired_change": { "type": ["string", "null"] },
              "priority": { "enum": ["low", "medium", "high"] }
            }
          }
        }
      }
    },
    "acceptSoundPackagePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_revision_id", "confirmed"],
      "properties": {
        "prompt_revision_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "confirmed": { "const": true },
        "user_reason": { "type": ["string", "null"] }
      }
    },
    "reopenLyricsPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "reason", "return_stage"],
      "properties": {
        "confirmed": { "const": true },
        "reason": { "type": "string", "minLength": 1 },
        "return_stage": {
          "enum": ["proposition_choice", "hook_development", "form_choice", "draft_generation", "section_revision", "line_revision"]
        },
        "invalidated_prompt_revision_id": { "type": ["string", "null"] }
      }
    },
    "recordLearningPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_event_ids"],
      "properties": {
        "source_event_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "requested_scope": { "enum": ["current_work", "personal_memory", "universal_knowledge", "project_process"] }
      }
    }
  }
}
